# Copy to `.env` and fill in. Never commit `.env`.
# Only SARVAM_API_KEY and one LLM key are needed to try the web console;
# everything else has a working default or an offline fallback.

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" enforces ADMIN_API_TOKEN and hides /docs
APP_ENV=development
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# ── Security ─────────────────────────────────────────────────────────────────
# Required in production (24+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Sites allowed to call the API from a browser, comma separated.
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ── Speech: Sarvam AI (https://dashboard.sarvam.ai) ──────────────────────────
SARVAM_API_KEY=
TTS_SPEAKER=shubh
TTS_LANGUAGE=en-IN

# ── Language model ───────────────────────────────────────────────────────────
# Preferred provider: openai | groq | sarvam. Others with a key act as fallbacks.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
# openai/gpt-oss-120b gives better answers than the small default.
GROQ_MODEL=llama-3.1-8b-instant
SARVAM_LLM_MODEL=sarvam-m
# A provider that stops sending tokens for this long is abandoned for the next one.
LLM_STALL_TIMEOUT_SEC=8
# For reasoning models (gpt-oss, o-series): low keeps voice replies fast.
LLM_REASONING_EFFORT=low
# Start speaking at the first clause once it is this many characters (0 = full sentences).
FIRST_CHUNK_MIN_CHARS=40

# ── Knowledge base ───────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
# Downloaded on first start. Changing it needs: python scripts/reindex_kb.py
EMBEDDING_MODEL=all-MiniLM-L6-v2
# hybrid = meaning + keywords (recommended); dense = meaning only
RETRIEVAL_MODE=hybrid
# Passages given to the model per answer
TOP_K_RETRIEVAL=3
# Weight of the keyword match in hybrid search
LEXICAL_WEIGHT=0.2
# Drop passages scoring this far below the best one
RELEVANCE_MARGIN=0.15
# Optional cross-encoder re-ranking (slower, downloads a second model)
ENABLE_RERANKER=false

# ── Monitoring and evaluation ────────────────────────────────────────────────
# Every turn is traced (timings, model, passages, cost) for the Monitoring page.
TRACING_ENABLED=true
# false keeps timings but not the question and answer text
TRACE_STORE_TEXT=true
TRACE_RETENTION_DAYS=30
EVAL_DATA_DIR=./data/eval

# ── Appointments: Cal.com (leave the key empty for local mock mode) ──────────
CAL_API_KEY=
# Numeric id of the event type to book; required when CAL_API_KEY is set
CAL_EVENT_TYPE_ID=
BOOKING_TIMEZONE=Asia/Kolkata
OFFICE_START_HOUR=9
OFFICE_END_HOUR=19
BOOKINGS_DB_PATH=./bookings.db

# ── Telephony: LiveKit Cloud + Vobiz SIP trunk (optional) ────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_OUTBOUND_NUMBER=
# Printed by: python setup_vobiz_trunk.py
OUTBOUND_TRUNK_ID=
BUSINESS_NAME=our office
CALL_GREETING=Hello! Thanks for calling. How can I help you today?
